+            || root_snapshot.session_source.is_non_root_agent()
+            || root_thread.session.multi_agent_version() != Some(MultiAgentVersion::V2)
+        {
+            return Err(CodexErr::InvalidRequest(format!(
+                "thread {root_thread_id} is not a MultiAgentV2 root"
+            )));
+        }
+        if target_thread_id == root_thread_id
+            || !self
+                .list_agent_subtree_thread_ids(root_thread_id)
+                .await?
+                .contains(&target_thread_id)
+        {
+            return Err(CodexErr::InvalidRequest(format!(
+                "thread {target_thread_id} is not a descendant of root {root_thread_id}"
+            )));
+        }
+
+        let root_config = root_thread.session.get_config().await;
+        let agent_control = root_thread.session.services.agent_control.clone();
+        agent_control
+            .restore_v2_agent_metadata(root_config.as_ref(), root_thread_id)
+            .await;
+        let target_metadata = agent_control.ensure_agent_known(target_thread_id)?;
+        let recipient = target_metadata.agent_path.ok_or_else(|| {
+            CodexErr::InvalidRequest(format!(
+                "subagent {target_thread_id} is missing its canonical agent path"
+            ))
+        })?;
+        if recipient.is_root() {
+            return Err(CodexErr::InvalidRequest(
+                "control-plane subagent messages cannot target the root agent".to_string(),
+            ));
+        }
+        let mut resume_config = (*root_config).clone();
+        resume_config.base_instructions = None;
+        agent_control
+            .ensure_v2_agent_loaded(resume_config, target_thread_id)
+            .await?;
+
+        let communication = InterAgentCommunication::new(
+            AgentPath::root(),
+            recipient,
+            Vec::new(),
+            message,
+            trigger_turn,
+        );
+        let kind = if trigger_turn {
+            AgentCommunicationKind::ControlPlaneFollowup
+        } else {
+            AgentCommunicationKind::ControlPlaneMessage
+        };
+        agent_control
+            .send_inter_agent_communication(
+                target_thread_id,
+                communication,
+                AgentCommunicationContext::new(kind, root_thread_id),
+            )
+            .await
+    }
