+pub(crate) fn apply_intatis_agent_workspace_preset(
+    config: &mut Config,
+    preset_id: &str,
+    preset: &IntatisAgentWorkspacePreset,
+    approved_parent_roots: &[AbsolutePathBuf],
+) -> Result<(AbsolutePathBuf, Vec<AbsolutePathBuf>), String> {
+    let cwd = AbsolutePathBuf::from_absolute_path_checked(&preset.cwd)
+        .map_err(|err| format!("workspace preset `{preset_id}` has an invalid cwd: {err}"))?;
+    if preset.workspace_roots.is_empty() {
+        return Err(format!(
+            "workspace preset `{preset_id}` has no workspace roots"
+        ));
+    }
+    let mut workspace_roots = Vec::with_capacity(preset.workspace_roots.len());
+    for root in &preset.workspace_roots {
+        let root = AbsolutePathBuf::from_absolute_path_checked(root).map_err(|err| {
+            format!("workspace preset `{preset_id}` has an invalid workspace root: {err}")
+        })?;
+        if workspace_roots.contains(&root) {
+            return Err(format!(
+                "workspace preset `{preset_id}` contains duplicate workspace roots"
+            ));
+        }
+        workspace_roots.push(root);
+    }
+    if !workspace_roots
+        .iter()
+        .any(|root| cwd.as_path().starts_with(root.as_path()))
+    {
+        return Err(format!(
+            "workspace preset `{preset_id}` cwd is outside its workspace roots"
+        ));
+    }
+    if workspace_roots
+        .iter()
+        .any(|root| !approved_parent_roots.contains(root))
+    {
+        return Err(format!(
+            "workspace preset `{preset_id}` includes a root that is not approved by the parent turn"
+        ));
+    }
+
+    let permission_profile = match preset.sandbox {
+        IntatisAgentWorkspaceSandbox::ReadOnly => PermissionProfile::read_only(),
+        IntatisAgentWorkspaceSandbox::WorkspaceWrite => PermissionProfile::workspace_write(),
+    };
+    config
+        .permissions
+        .replace_permission_profile_from_session_snapshot(PermissionProfileSnapshot::legacy(
+            permission_profile,
+        ))
+        .map_err(|err| {
+            format!("workspace preset `{preset_id}` has an invalid sandbox profile: {err}")
+        })?;
+    config.cwd = cwd.clone();
+    config.workspace_roots = workspace_roots.clone();
+    config.workspace_roots_explicit = true;
+    config
+        .permissions
+        .set_workspace_roots(workspace_roots.clone());
+
+    Ok((cwd, workspace_roots))
+}
