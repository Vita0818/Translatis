+fn validate_intatis_agent_workspaces(
+    workspaces: &BTreeMap<String, IntatisAgentWorkspacePreset>,
+) -> std::io::Result<()> {
+    const ID_MAX_CHARS: usize = 64;
+    const DESCRIPTION_MAX_CHARS: usize = 512;
+
+    for (id, workspace) in workspaces {
+        let label = format!("features.multi_agent_v2.intatis_agent_workspaces.{id}");
+        if id.is_empty()
+            || id.chars().count() > ID_MAX_CHARS
+            || !id
+                .bytes()
+                .all(|byte| byte.is_ascii_alphanumeric() || matches!(byte, b'_' | b'-'))
+        {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                "features.multi_agent_v2.intatis_agent_workspaces keys must match ^[a-zA-Z0-9_-]{1,64}$",
+            ));
+        }
+        if workspace.description.trim() != workspace.description
+            || workspace.description.is_empty()
+            || workspace.description.chars().count() > DESCRIPTION_MAX_CHARS
+            || workspace.description.chars().any(char::is_control)
+        {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                format!(
+                    "{label}.description must be a trimmed, nonempty, single-line description of at most {DESCRIPTION_MAX_CHARS} characters"
+                ),
+            ));
+        }
+        let cwd = AbsolutePathBuf::from_absolute_path_checked(&workspace.cwd).map_err(|err| {
+            std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                format!("{label}.cwd must be an absolute normalized path: {err}"),
+            )
+        })?;
+        if workspace.workspace_roots.is_empty() {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                format!("{label}.workspace_roots must not be empty"),
+            ));
+        }
+        let mut roots = Vec::with_capacity(workspace.workspace_roots.len());
+        for root in &workspace.workspace_roots {
+            let root = AbsolutePathBuf::from_absolute_path_checked(root).map_err(|err| {
+                std::io::Error::new(
+                    std::io::ErrorKind::InvalidInput,
+                    format!(
+                        "{label}.workspace_roots entries must be absolute normalized paths: {err}"
+                    ),
+                )
+            })?;
+            if roots.contains(&root) {
+                return Err(std::io::Error::new(
+                    std::io::ErrorKind::InvalidInput,
+                    format!("{label}.workspace_roots must not contain duplicates"),
+                ));
+            }
+            roots.push(root);
+        }
+        if !roots
+            .iter()
+            .any(|root| cwd.as_path().starts_with(root.as_path()))
+        {
+            return Err(std::io::Error::new(
+                std::io::ErrorKind::InvalidInput,
+                format!("{label}.cwd must be contained by one of its workspace_roots"),
+            ));
+        }
+    }
+
+    Ok(())
+}
