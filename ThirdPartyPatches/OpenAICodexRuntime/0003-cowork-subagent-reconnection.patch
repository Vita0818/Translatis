+fn validate_subagent_message(message: &str) -> Result<(), JSONRPCErrorError> {
+    if message.trim().is_empty() {
+        return Err(invalid_params("message must not be empty"));
+    }
+    let actual_chars = message.chars().count();
+    if actual_chars > MAX_USER_INPUT_TEXT_CHARS {
+        let mut error = invalid_params(format!(
+            "message exceeds the maximum length of {MAX_USER_INPUT_TEXT_CHARS} characters"
+        ));
+        error.data = Some(serde_json::json!({
+            "input_error_code": INPUT_TOO_LARGE_ERROR_CODE,
+            "max_chars": MAX_USER_INPUT_TEXT_CHARS,
+            "actual_chars": actual_chars,
+        }));
+        return Err(error);
+    }
+    Ok(())
+}
