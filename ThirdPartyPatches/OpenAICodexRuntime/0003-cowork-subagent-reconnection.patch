+fn resolve_intatis_agent_workspace(
+    config: &mut crate::config::Config,
+    turn: &crate::session::turn_context::TurnContext,
+    requested_workspace: Option<&str>,
+) -> Result<Vec<TurnEnvironmentSelection>, FunctionCallError> {
+    let Some(requested_workspace) = requested_workspace else {
+        return Ok(turn.environments.to_selections());
+    };
+    let requested_workspace = requested_workspace.trim();
+    if requested_workspace.is_empty() {
+        return Err(FunctionCallError::RespondToModel(
+            "workspace preset id must not be empty".to_string(),
+        ));
+    }
+    let preset = turn
+        .config
+        .multi_agent_v2
+        .intatis_agent_workspaces
+        .get(requested_workspace)
+        .ok_or_else(|| {
+            FunctionCallError::RespondToModel(format!(
+                "unknown workspace preset `{requested_workspace}`"
+            ))
+        })?;
+
+    let (cwd, workspace_roots) = apply_intatis_agent_workspace_preset(
+        config,
+        requested_workspace,
+        preset,
+        &turn.config.workspace_roots,
+    )
+    .map_err(FunctionCallError::RespondToModel)?;
+
+    Ok(turn
+        .environments
+        .to_selections()
+        .into_iter()
+        .map(|selection| TurnEnvironmentSelection {
+            environment_id: selection.environment_id,
+            cwd: PathUri::from_abs_path(&cwd),
+            workspace_roots: workspace_roots.iter().map(PathUri::from_abs_path).collect(),
+        })
+        .collect())
 }
 
