    "Create a privacy-redacted ZIP containing app and session structure, provider and network errors, performance and hang data, and recent Translatis crash reports. Message contents, API keys, configuration files, workspace files, and browser data are excluded. Nothing is uploaded." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a privacy-redacted ZIP containing app and session structure, provider and network errors, performance and hang data, and recent Translatis crash reports. Message contents, API keys, configuration files, workspace files, and browser data are excluded. Nothing is uploaded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成经过隐私脱敏的 ZIP，包含 App 与会话结构、提供商和网络错误、性能与卡顿数据，以及近期 Translatis 崩溃报告。消息内容、API 密钥、配置文件、工作区文件和浏览器数据不会包含，也不会上传任何内容。"
          }
        }
      }
    },
