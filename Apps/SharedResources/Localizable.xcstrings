    "%@ will be disabled and its current immutable revision tombstoned. %@ live connection authorities will be drained, and %@ Code/Cowork sessions currently reference this revision. Those sessions retain secret-free history and must detach or attach another tested revision before reconnecting." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ will be disabled and its current immutable revision tombstoned. %2$@ live connection authorities will be drained, and %3$@ Code/Cowork sessions currently reference this revision. Those sessions retain secret-free history and must detach or attach another tested revision before reconnecting."
          }
        }
      }
    },
    "%@ will be disabled and its current immutable revision tombstoned. %lld live connection authorities will be drained, and %lld Code/Cowork sessions currently reference this revision. Those sessions retain secret-free history and must detach or attach another tested revision before reconnecting." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ will be disabled and its current immutable revision tombstoned. %2$lld live connection authorities will be drained, and %3$lld Code/Cowork sessions currently reference this revision. Those sessions retain secret-free history and must detach or attach another tested revision before reconnecting."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 将被停用，其当前不可变修订也会被封存。系统将排空 %2$lld 个实时连接权限；目前有 %3$lld 个 Code/Cowork 会话引用此修订。这些会话会保留不含密钥的历史记录，并且必须先分离或挂接另一个已测试的修订才能重新连接。"
          }
        }
      }
    },
    "%@ will be disabled and its current immutable revision tombstoned. Existing session authority and audit history are retained." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will be disabled and its current immutable revision tombstoned. Existing session authority and audit history are retained."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 将被停用，其当前不可变修订将被标记为已删除。现有会话权限与审计历史会保留。"
          }
        }
      }
    },
