          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此选择会立即保存并应用，且不受提供商“保存”操作影响。富文本 Markdown 使用经过审核的上游渲染器，首个版本暂不启用图像、数学公式排版和语法高亮。纯文本安全模式会完全绕过 Markdown。原始会话数据不会改变。"
          }
        }
      }
