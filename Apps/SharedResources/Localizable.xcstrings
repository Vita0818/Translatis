    "The provider request is paused. Allowing writes durable consent for only the exact immutable server revision, Agent authority, account/environment, roots, network policy, sandbox policy, and launch artifact shown below. Test and sign-in authorization never counts as this consent." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The provider request is paused. Allowing writes durable consent for only the exact immutable server revision, Agent authority, account/environment, roots, network policy, sandbox policy, and launch artifact shown below. Test and sign-in authorization never counts as this consent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供方请求已暂停。允许后只会为下方所示的精确不可变服务器修订、Agent 权限、账户/环境、根目录、网络策略、沙箱策略和启动产物写入持久同意。测试与登录授权绝不视为此项同意。"
          }
        }
      }
    },
    "The provider stopped after partial output. The partial text is preserved. Check the API key source, provider access, selected model, and endpoint before retrying." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The provider stopped after partial output. The partial text is preserved. Check the API key source, provider access, selected model, and endpoint before retrying."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供商在输出部分内容后停止了回答。已保留这部分文字。重试前，请检查 API 密钥来源、提供商访问权限、所选模型和端点。"
          }
        }
      }
    },
    "The provider stopped after partial output. The partial text is preserved. Check the provider message, endpoint, selected model, and request shape before rerunning." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The provider stopped after partial output. The partial text is preserved. Check the provider message, endpoint, selected model, and request shape before rerunning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供商在输出部分内容后停止了回答。已保留这部分文字。重新运行前，请检查提供商消息、端点、所选模型和请求结构。"
          }
        }
      }
    },
    "The provider stopped after partial output. The partial text is preserved. No recovery is needed unless you still want the result; rerun the request when ready." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The provider stopped after partial output. The partial text is preserved. No recovery is needed unless you still want the result; rerun the request when ready."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供商在输出部分内容后停止了回答。已保留这部分文字。除非你仍需要结果，否则无需恢复；准备好后可重新运行请求。"
          }
        }
      }
    },
    "The provider stopped after partial output. The partial text is preserved. Review the provider error before retrying." : {
