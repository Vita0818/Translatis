{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.intatis.local/knowledge/search-knowledge-input-v1.schema.json",
  "title": "Intatis search_knowledge input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "knowledge_base",
    "query"
  ],
  "properties": {
    "knowledge_base": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 8
    }
  }
}
