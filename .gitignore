# SwiftPM
.build/
.swiftpm/

# External dependency source checkouts are provisioned locally and are not
# committed to this repository. Package.swift consumes these paths when the
# local dependency bundle has been prepared.
Vendor/

# Keep the root lockfile tracked so audited renderer dependencies stay exact.

# Xcode
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/
dist/
*.xcuserstate

# Generated by XcodeGen (run `make app` / `xcodegen generate` to recreate)
Translatis.xcodeproj/

# macOS
.DS_Store

# Translatis product-local runtime/worktree state
.translatis/

# Secrets / local config (never commit)
*.env
.env
secrets.json
Config.local.*
